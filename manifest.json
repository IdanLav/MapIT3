{
  "name": "MapIt",
  "short_name": "MapIt",
  "description": "Share a travel video or screenshot – AI finds the location and opens Google Maps",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f0f1a",
  "theme_color": "#4361ee",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text":  "text",
      "url":   "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*", "video/mp4", "video/quicktime", "video/webm"]
        }
      ]
    }
  },
  "categories": ["travel", "utilities"]
}
